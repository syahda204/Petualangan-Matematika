          <div class="stat">
            🎯 <span id="questionDisplay">1/20</span>
          </div>
        </div>

        <div class="progress-wrap">
          <div class="progress-info">
            <span>Progress Petualangan</span>
            <span id="progressText">0%</span>
          </div>

          <div class="progress-track">
            <div id="progressBar" class="progress-bar"></div>
          </div>
        </div>
      </header>

      <article class="game-card">
        <div id="levelLabel" class="level-label">
          Level 1 • Pemula
        </div>

        <div id="questionText" class="question"></div>

        <div id="numberDisplay" class="number-display hidden"></div>

        <div id="options" class="options"></div>

        <div id="feedback" class="feedback">
          <div id="feedbackTitle" class="feedback-title"></div>
          <div id="feedbackText"></div>
        </div>

        <div class="next-wrap">
          <button id="nextBtn" class="primary-btn next-btn">
            Lanjut ➜
          </button>
        </div>
      </article>
    </section>

    <!-- =========================
         LAYAR HASIL
    ========================== -->
    <section id="resultScreen" class="screen">
      <div class="result-card">
        <div class="result-icon">🏆</div>

        <h2>Petualangan Selesai!</h2>

        <div id="resultMessage" class="subtitle"></div>

        <div id="finalScore" class="final-score">0 ⭐</div>

        <div id="starsDisplay" class="stars"></div>

        <div class="result-stats">
          <div class="result-stat">
            <span id="correctDisplay" class="value">0</span>
            <span class="label">Jawaban Benar</span>
          </div>

          <div class="result-stat">
            <span id="wrongDisplay" class="value">0</span>
            <span class="label">Jawaban Salah</span>
          </div>

          <div class="result-stat">
            <span id="accuracyDisplay" class="value">0%</span>
            <span class="label">Ketepatan</span>
          </div>
        </div>

        <div class="reflection">
          <p>
            💭 <strong>Konsep mana yang sudah kamu kuasai?</strong>
          </p>
          <p>
            💭 <strong>Bagian mana yang perlu kamu latih lagi?</strong>
          </p>
          <p>
            Ingat, kesalahan bukan kegagalan. Kesalahan membantu kita
            menemukan bagian yang perlu dipelajari lagi. Tetap semangat! 🌟
          </p>
        </div>

        <button id="restartBtn" class="primary-btn">
          🔄 Main Lagi
        </button>
      </div>
    </section>

  </main>

  <script>
    "use strict";

    /* ==========================================================
       PETUALANGAN BILANGAN: MISI 100.000
       JavaScript murni - tanpa library eksternal
       ========================================================== */

    const TOTAL_QUESTIONS = 20;
    const STARTING_LIVES = 3;
    const POINTS_PER_CORRECT = 10;

    let questions = [];
    let currentQuestion = 0;
    let score = 0;
    let lives = STARTING_LIVES;
    let correctAnswers = 0;
    let wrongAnswers = 0;
    let answered = false;

    const startScreen = document.getElementById("startScreen");
    const gameScreen = document.getElementById("gameScreen");
    const resultScreen = document.getElementById("resultScreen");

    const startBtn = document.getElementById("startBtn");
    const restartBtn = document.getElementById("restartBtn");
    const nextBtn = document.getElementById("nextBtn");

    const scoreDisplay = document.getElementById("scoreDisplay");
    const livesDisplay = document.getElementById("livesDisplay");
    const questionDisplay = document.getElementById("questionDisplay");
    const progressBar = document.getElementById("progressBar");
    const progressText = document.getElementById("progressText");

    const levelLabel = document.getElementById("levelLabel");
    const questionText = document.getElementById("questionText");
    const numberDisplay = document.getElementById("numberDisplay");
    const options = document.getElementById("options");

    const feedback = document.getElementById("feedback");
    const feedbackTitle = document.getElementById("feedbackTitle");
    const feedbackText = document.getElementById("feedbackText");

    const finalScore = document.getElementById("finalScore");
    const correctDisplay = document.getElementById("correctDisplay");
    const wrongDisplay = document.getElementById("wrongDisplay");
    const accuracyDisplay = document.getElementById("accuracyDisplay");
    const starsDisplay = document.getElementById("starsDisplay");
    const resultMessage = document.getElementById("resultMessage");

    /* ==========================================================
       AUDIO
       ========================================================== */

    let audioContext = null;

    function initAudio() {
      try {
        if (!audioContext) {
          audioContext = new (window.AudioContext || window.webkitAudioContext)();
        }

        if (audioContext.state === "suspended") {
          audioContext.resume();
        }
      } catch (error) {
        // Audio tidak wajib agar gim tetap berjalan.
      }
    }

    function playTone(frequency, duration, type = "sine", volume = 0.06) {
      if (!audioContext) return;

      try {
        const oscillator = audioContext.createOscillator();
        const gain = audioContext.createGain();

        oscillator.type = type;
        oscillator.frequency.setValueAtTime(
          frequency,
          audioContext.currentTime
        );

        gain.gain.setValueAtTime(volume, audioContext.currentTime);
        gain.gain.exponentialRampToValueAtTime(
          0.001,
          audioContext.currentTime + duration
        );

        oscillator.connect(gain);
        gain.connect(audioContext.destination);

        oscillator.start();
        oscillator.stop(audioContext.currentTime + duration);
      } catch (error) {
        // Abaikan error audio agar permainan tetap berjalan.
      }
    }

    function playCorrectSound() {
      initAudio();
      playTone(523.25, 0.12, "sine", 0.05);

      setTimeout(() => {
        playTone(659.25, 0.14, "sine", 0.05);
      }, 100);

      setTimeout(() => {
        playTone(783.99, 0.18, "sine", 0.05);
      }, 210);
    }

    function playWrongSound() {
      initAudio();
      playTone(220, 0.18, "sawtooth", 0.035);

      setTimeout(() => {
        playTone(165, 0.22, "sawtooth", 0.03);
      }, 130);
    }

    /* ==========================================================
       UTILITAS
       ========================================================== */

    function shuffle(array) {
      const result = [...array];

      for (let i = result.length - 1; i > 0; i--) {
        const j = Math.floor(Math.random() * (i + 1));
        [result[i], result[j]] = [result[j], result[i]];
      }

      return result;
    }

    function randomInt(min, max) {
      return Math.floor(Math.random() * (max - min + 1)) + min;
    }

    function formatNumber(number) {
      return number.toLocaleString("id-ID");
    }

    function showScreen(screen) {
      [startScreen, gameScreen, resultScreen].forEach((element) => {
        element.classList.remove("active");
      });

      screen.classList.add("active");
      window.scrollTo({ top: 0, behavior: "smooth" });
    }

    /* ==========================================================
       PEMBUATAN SOAL
       ========================================================== */

    function makeQuestion(question, answer, distractors, explanation, level, type) {
      const allOptions = shuffle([
        String(answer),
        ...distractors.map(String)
      ]);

      return {
        question,
        answer: String(answer),
        options: allOptions,
        explanation,
        level,
        type
      };
    }

    function generateQuestions() {
      const bank = [];

      /* ----------------------------------------------------------
         LEVEL 1 - Nilai Tempat dan Nilai Angka
         ---------------------------------------------------------- */

      bank.push(
        makeQuestion(
          "Pada bilangan 47.325, angka 7 menempati nilai tempat ...",
          "ribuan",
          ["ratusan", "puluhan", "satuan"],
          "Pada 47.325, angka 7 berada di posisi ribuan.",
          1,
          "nilai tempat"
        )
      );

      bank.push(
        makeQuestion(
          "Pada bilangan 68.214, nilai angka 8 adalah ...",
          "8.000",
          ["800", "80", "8"],
          "Angka 8 berada di tempat ribuan, sehingga nilainya adalah 8.000.",
          1,
          "nilai angka"
        )
      );

      bank.push(
        makeQuestion(
          "Nilai tempat angka 5 pada bilangan 25.641 adalah ...",
          "ribuan",
          ["puluh ribuan", "ratusan", "puluhan"],
          "Bilangan 25.641 memiliki 5 pada posisi ribuan.",
          1,
          "nilai tempat"
        )
      );

      bank.push(
        makeQuestion(
          "Nilai angka 9 pada bilangan 93.407 adalah ...",
          "90.000",
          ["9.000", "900", "90"],
          "Angka 9 berada di tempat puluh ribuan, jadi nilainya 90.000.",
          1,
          "nilai angka"
        )
      );

      bank.push(
        makeQuestion(
          "Angka yang menempati tempat ratusan pada bilangan 72.586 adalah ...",
          "5",
          ["7", "8", "6"],
          "Pada 72.586, urutannya adalah 7 puluh ribuan, 2 ribuan, 5 ratusan, 8 puluhan, 6 satuan.",
          1,
          "nilai tempat"
        )
      );

      bank.push(
        makeQuestion(
          "Bentuk panjang dari 34.205 adalah ...",
          "30.000 + 4.000 + 200 + 5",
          [
            "30.000 + 400 + 20 + 5",
            "3.000 + 4.000 + 200 + 5",
            "30.000 + 4.000 + 20 + 5"
          ],
          "34.205 = 30.000 + 4.000 + 200 + 5.",
          1,
          "bentuk panjang"
        )
      );

      /* ----------------------------------------------------------
         LEVEL 2 - Membandingkan Bilangan
         ---------------------------------------------------------- */

      bank.push(
        makeQuestion(
          "Bilangan manakah yang paling besar?",
          "56.780",
          ["56.708", "56.087", "55.999"],
          "Bandingkan dari puluh ribuan lalu ribuan. 56.780 paling besar.",
          2,
          "membandingkan"
        )
      );

      bank.push(
        makeQuestion(
          "Pernyataan yang benar adalah ...",
          "42.315 > 42.135",
          [
            "42.315 < 42.135",
            "42.315 = 42.135",
            "42.315 < 41.999"
          ],
          "Kedua bilangan sama-sama 42 ribuan. Karena 315 lebih besar dari 135, maka 42.315 > 42.135.",
          2,
          "membandingkan"
        )
      );

      bank.push(
        makeQuestion(
          "Bilangan manakah yang paling kecil?",
          "18.905",
          ["19.085", "18.950", "19.005"],
          "18 ribuan lebih kecil daripada 19 ribuan. Di antara bilangan 18 ribuan, 18.905 paling kecil.",
          2,
          "membandingkan"
        )
      );

      bank.push(
        makeQuestion(
          "Tanda yang tepat untuk 73.450 ... 73.405 adalah ...",
          ">",
          ["<", "=", "≤"],
          "Kedua bilangan memiliki 73 ribuan. 450 lebih besar daripada 405, sehingga tandanya >.",
          2,
          "membandingkan"
        )
      );

      /* ----------------------------------------------------------
         LEVEL 3 - Mengurutkan Bilangan
         ---------------------------------------------------------- */

      bank.push(
        makeQuestion(
          "Urutan dari yang terkecil ke terbesar adalah ...",
          "12.450, 12.540, 12.504, 12.540",
          [
            "12.450, 12.504, 12.540, 12.540",
            "12.540, 12.504, 12.450, 12.540",
            "12.504, 12.450, 12.540, 12.540"
          ],
          "Perhatikan: 12.450 < 12.504 < 12.540. Karena 12.540 muncul dua kali, keduanya berurutan.",
          3,
          "mengurutkan"
        )
      );

      /*
       * Soal di atas memiliki dua angka yang sama.
       * Agar tidak membingungkan, soal ini akan diganti dengan
       * versi empat bilangan yang semuanya berbeda.
       */
      bank[10] = makeQuestion(
        "Urutan dari yang terkecil ke terbesar adalah ...",
        "12.450, 12.504, 12.540, 12.580",
        [
          "12.450, 12.540, 12.504, 12.580",
          "12.580, 12.540, 12.504, 12.450",
          "12.504, 12.450, 12.580, 12.540"
        ],
        "Urutan yang benar adalah 12.450 < 12.504 < 12.540 < 12.580.",
        3,
        "mengurutkan"
      );

      bank.push(
        makeQuestion(
          "Urutan dari terbesar ke terkecil adalah ...",
          "45.800, 45.080, 44.999, 44.099",
          [
            "44.099, 44.999, 45.080, 45.800",
            "45.080, 45.800, 44.099, 44.999",
            "45.800, 44.999, 45.080, 44.099"
          ],
          "Mulai dari bilangan terbesar: 45.800, lalu 45.080, 44.999, dan 44.099.",
          3,
          "mengurutkan"
        )
      );

      bank.push(
        makeQuestion(
          "Urutan dari terkecil ke terbesar adalah ...",
          "7.890, 8.009, 8.090, 8.900",
          [
            "8.009, 7.890, 8.090, 8.900",
            "8.900, 8.090, 8.009, 7.890",
            "7.890, 8.090, 8.009, 8.900"
          ],
          "7.890 paling kecil, kemudian 8.009, 8.090, dan 8.900.",
          3,
          "mengurutkan"
        )
      );

      /* ----------------------------------------------------------
         LEVEL 4 - Penjumlahan dan Pengurangan
         ---------------------------------------------------------- */

      bank.push(
        makeQuestion(
          "Hasil dari 24.500 + 13.250 adalah ...",
          "37.750",
          ["36.750", "37.250", "38.750"],
          "24.500 + 13.250 = 37.750.",
          4,
          "operasi hitung"
        )
      );

      bank.push(
        makeQuestion(
          "Hasil dari 65.000 - 27.500 adalah ...",
          "37.500",
          ["38.500", "36.500", "37.250"],
          "65.000 dikurangi 27.500 sama dengan 37.500.",
          4,
          "operasi hitung"
        )
      );

      bank.push(
        makeQuestion(
          "Hasil dari 18.750 + 21.125 adalah ...",
          "39.875",
          ["39.775", "40.875", "38.875"],
          "18.750 + 21.125 = 39.875.",
          4,
          "operasi hitung"
        )
      );

      bank.push(
        makeQuestion(
          "Hasil dari 90.000 - 45.675 adalah ...",
          "44.325",
          ["45.325", "44.425", "43.325"],
          "90.000 - 45.675 = 44.325.",
          4,
          "operasi hitung"
        )
      );

      /* ----------------------------------------------------------
         LEVEL 5 - Operasi Hitung dan Soal Cerita
         ---------------------------------------------------------- */

      bank.push(
        makeQuestion(
          "Perpustakaan memiliki 25.000 buku. Sebanyak 7.500 buku dipinjam. Sisa buku adalah ...",
          "17.500",
          ["18.500", "17.000", "16.500"],
          "25.000 - 7.500 = 17.500 buku.",
          5,
          "soal cerita"
        )
      );

      bank.push(
        makeQuestion(
          "Sebuah toko memiliki 12.500 pensil. Toko menerima 5.250 pensil lagi. Jumlah pensil sekarang ...",
          "17.750",
          ["17.250", "18.750", "16.750"],
          "12.500 + 5.250 = 17.750 pensil.",
          5,
          "soal cerita"
        )
      );

      bank.push(
        makeQuestion(
          "Hasil dari 75.000 - 18.750 + 2.500 adalah ...",
          "58.750",
          ["56.250", "59.750", "57.500"],
          "Kerjakan dari kiri: 75.000 - 18.750 = 56.250, lalu 56.250 + 2.500 = 58.750.",
          5,
          "operasi hitung"
        )
      );

      bank.push(
        makeQuestion(
          "Budi memiliki 40.000 poin. Ia mendapat tambahan 12.500 poin, lalu menggunakan 7.500 poin. Sisa poin Budi adalah ...",
          "45.000",
          ["42.500", "44.000", "47.500"],
          "40.000 + 12.500 = 52.500, kemudian 52.500 - 7.500 = 45.000.",
          5,
          "soal cerita"
        )
      );

      bank.push(
        makeQuestion(
          "Hasil dari 32.450 + 14.550 - 10.000 adalah ...",
          "37.000",
          ["36.000", "38.000", "47.000"],
          "32.450 + 14.550 = 47.000, kemudian 47.000 - 10.000 = 37.000.",
          5,
          "operasi hitung"
        )
      );

      bank.push(
        makeQuestion(
          "Bilangan yang tepat untuk melengkapi 45.000 + ... = 68.500 adalah ...",
          "23.500",
          ["22.500", "24.500", "25.500"],
          "68.500 - 45.000 = 23.500.",
          5,
          "operasi hitung"
        )
      );

      return shuffle(bank).slice(0, TOTAL_QUESTIONS);
    }

    /* ==========================================================
       LEVEL
       ========================================================== */

    function getLevelName(level) {
      const names = {
        1: "Pemula",
        2: "Penjelajah",
        3: "Ahli Urutan",
        4: "Jago Hitung",
        5: "Master Bilangan"
      };

      return names[level] || "Penjelajah";
    }

    /* ==========================================================
       MULAI PERMAINAN
       ========================================================== */

    function startGame() {
      initAudio();

      questions = generateQuestions();

      currentQuestion = 0;
      score = 0;
      lives = STARTING_LIVES;
      correctAnswers = 0;
      wrongAnswers = 0;
      answered = false;

      updateHeader();
      showScreen(gameScreen);
      renderQuestion();
    }

    /* ==========================================================
       HEADER
       ========================================================== */

    function updateHeader() {
      scoreDisplay.textContent = score;
      livesDisplay.textContent = lives;
      questionDisplay.textContent =
        `${Math.min(currentQuestion + 1, TOTAL_QUESTIONS)}/${TOTAL_QUESTIONS}`;

      const completed = currentQuestion / TOTAL_QUESTIONS;
      const percentage = Math.round(completed * 100);

      progressBar.style.width = `${percentage}%`;
      progressText.textContent = `${percentage}%`;
    }

    /* ==========================================================
       MENAMPILKAN SOAL
       ========================================================== */

    function renderQuestion() {
      if (currentQuestion >= questions.length || lives <= 0) {
        finishGame();
        return;
      }

      answered = false;

      const item = questions[currentQuestion];

      levelLabel.textContent =
        `Level ${item.level} • ${getLevelName(item.level)}`;

      questionText.textContent = item.question;

      numberDisplay.classList.add("hidden");
      numberDisplay.textContent = "";

      options.innerHTML = "";

      feedback.className = "feedback";
      feedbackTitle.textContent = "";
      feedbackText.textContent = "";

      nextBtn.classList.remove("show");

      item.options.forEach((option, index) => {
        const button = document.createElement("button");

        button.type = "button";
        button.className = "option-btn";
        button.textContent = option;
        button.dataset.option = option;
        button.setAttribute(
          "aria-label",
          `Pilihan jawaban ${index + 1}: ${option}`
        );

        button.addEventListener("click", () => {
          handleAnswer(button, option, item);
        });

        options.appendChild(button);
      });

      updateHeader();
    }

    /* ==========================================================
       MEMPROSES JAWABAN
       ========================================================== */

    function handleAnswer(selectedButton, selectedAnswer, item) {
      if (answered) return;

      answered = true;

      const allButtons = options.querySelectorAll(".option-btn");

      allButtons.forEach((button) => {
        button.disabled = true;

        if (button.dataset.option === item.answer) {
          button.classList.add("correct");
        }
      });

      if (selectedAnswer === item.answer) {
        score += POINTS_PER_CORRECT;
        correctAnswers++;

        selectedButton.classList.add("correct");

        feedback.className = "feedback correct show";
        feedbackTitle.textContent = "🎉 Jawaban benar!";
        feedbackText.innerHTML =
          `<strong>Hebat!</strong> ${item.explanation}`;

        playCorrectSound();
      } else {
        lives = Math.max(0, lives - 1);
        wrongAnswers++;

        selectedButton.classList.add("wrong");

        feedback.className = "feedback wrong show";
        feedbackTitle.textContent = "💡 Belum tepat, tidak apa-apa!";
        feedbackText.innerHTML =
          `<strong>Jawaban yang benar: ${item.answer}</strong><br>${item.explanation}`;

        playWrongSound();
      }

      updateHeader();

      if (lives <= 0) {
        nextBtn.textContent = "Lihat Hasil 🏆";
      } else if (currentQuestion >= questions.length - 1) {
        nextBtn.textContent = "Lihat Hasil 🏆";
      } else {
        nextBtn.textContent = "Lanjut ➜";
      }

      nextBtn.classList.add("show");
    }

    /* ==========================================================
       SOAL BERIKUTNYA
       ========================================================== */

    function nextQuestion() {
      if (!answered) return;

      currentQuestion++;

      if (currentQuestion >= questions.length || lives <= 0) {
        finishGame();
        return;
      }

      renderQuestion();
    }

    /* ==========================================================
       HASIL AKHIR
       ========================================================== */

    function finishGame() {
      showScreen(resultScreen);

      const totalAnswered = correctAnswers + wrongAnswers;
      const accuracy =
        totalAnswered > 0
          ? Math.round((correctAnswers / totalAnswered) * 100)
          : 0;

      finalScore.textContent = `${score} ⭐`;
      correctDisplay.textContent = correctAnswers;
      wrongDisplay.textContent = wrongAnswers;
      accuracyDisplay.textContent = `${accuracy}%`;

      let stars = "";

      if (accuracy >= 90) {
        stars = "⭐⭐⭐⭐⭐";
        resultMessage.textContent =
          "Luar biasa! Kamu menjelajah Kota Matematika dengan sangat baik!";
      } else if (accuracy >= 75) {
        stars = "⭐⭐⭐⭐";
        resultMessage.textContent =
          "Hebat! Kemampuan bilanganmu semakin kuat. Terus berlatih!";
      } else if (accuracy >= 60) {
        stars = "⭐⭐⭐";
        resultMessage.textContent =
          "Bagus! Kamu sudah memiliki dasar yang baik. Ayo terus berlatih!";
      } else if (accuracy >= 40) {
        stars = "⭐⭐";
        resultMessage.textContent =
          "Tetap semangat! Coba perhatikan kembali nilai tempat dan langkah berhitung.";
      } else {
        stars = "⭐";
        resultMessage.textContent =
          "Jangan menyerah! Setiap latihan membuat kemampuanmu semakin baik.";
      }

      starsDisplay.textContent = stars;
    }

    /* ==========================================================
       EVENT LISTENER
       ========================================================== */

    startBtn.addEventListener("click", startGame);

    restartBtn.addEventListener("click", startGame);

    nextBtn.addEventListener("click", nextQuestion);

    /* ==========================================================
       PENGECEKAN AWAL
       ========================================================== */

    // Pastikan layar awal aktif ketika halaman pertama kali dibuka.
    showScreen(startScreen);
  </script>
