<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Petualangan Bilangan: Misi 100.000</title>

  <style>
    * {
      box-sizing: border-box;
    }

    :root {
      --primary: #4f46e5;
      --primary-dark: #3730a3;
      --secondary: #f59e0b;
      --success: #16a34a;
      --danger: #dc2626;
      --info: #0284c7;
      --bg: #eef4ff;
      --card: #ffffff;
      --text: #1e293b;
      --muted: #64748b;
      --border: #dbe4f0;
    }

    body {
      margin: 0;
      min-height: 100vh;
      font-family: "Trebuchet MS", "Segoe UI", Arial, sans-serif;
      background:
        radial-gradient(circle at 10% 10%, #dbeafe 0, transparent 25%),
        radial-gradient(circle at 90% 20%, #fef3c7 0, transparent 25%),
        linear-gradient(135deg, #eef4ff, #f8fafc);
      color: var(--text);
    }

    button {
      font: inherit;
    }

    .app {
      width: min(1050px, 94%);
      margin: 0 auto;
      padding: 24px 0 40px;
    }

    .screen {
      display: none;
    }

    .screen.active {
      display: block;
    }

    /* OPENING */
    .start-card {
      min-height: 88vh;
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      text-align: center;
      padding: 30px;
    }

    .city {
      width: min(850px, 100%);
      padding: 36px 28px;
      background: rgba(255,255,255,.94);
      border: 2px solid rgba(79,70,229,.12);
      border-radius: 32px;
      box-shadow: 0 20px 60px rgba(30,41,59,.12);
    }

    .logo {
      font-size: 76px;
      margin-bottom: 5px;
      animation: float 3s ease-in-out infinite;
    }

    @keyframes float {
      0%, 100% { transform: translateY(0); }
      50% { transform: translateY(-8px); }
    }

    .start-card h1 {
      margin: 0;
      font-size: clamp(2rem, 6vw, 4rem);
      color: var(--primary);
      line-height: 1.1;
    }

    .subtitle {
      font-size: clamp(1rem, 2.5vw, 1.3rem);
      color: var(--muted);
      margin: 14px auto 24px;
      max-width: 700px;
      line-height: 1.6;
    }

    .instructions {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 14px;
      margin: 25px 0;
    }

    .instruction {
      padding: 18px;
      background: #f8fafc;
      border-radius: 18px;
      border: 1px solid var(--border);
    }

    .instruction .icon {
      font-size: 32px;
      display: block;
      margin-bottom: 7px;
    }

    .instruction strong {
      display: block;
      margin-bottom: 5px;
    }

    .instruction span {
      color: var(--muted);
      font-size: .92rem;
      line-height: 1.4;
    }

    .primary-btn,
    .secondary-btn {
      border: none;
      border-radius: 16px;
      padding: 15px 28px;
      font-weight: 800;
      cursor: pointer;
      transition: transform .15s, box-shadow .15s, background .15s;
    }

    .primary-btn {
      background: var(--primary);
      color: white;
      box-shadow: 0 8px 18px rgba(79,70,229,.25);
    }

    .primary-btn:hover,
    .secondary-btn:hover {
      transform: translateY(-2px);
    }

    .primary-btn:active,
    .secondary-btn:active {
      transform: translateY(1px);
    }

    .start-btn {
      font-size: 1.15rem;
      min-width: 210px;
    }

    /* GAME HEADER */
    .game-header {
      background: rgba(255,255,255,.96);
      border-radius: 22px;
      padding: 17px;
      box-shadow: 0 10px 35px rgba(30,41,59,.08);
      margin-bottom: 18px;
    }

    .top-row {
      display: grid;
      grid-template-columns: 1fr auto auto auto;
      gap: 12px;
      align-items: center;
    }

    .game-title {
      font-weight: 900;
      color: var(--primary);
      font-size: 1.15rem;
    }

    .stat {
      display: flex;
      align-items: center;
      gap: 6px;
      background: #f8fafc;
      padding: 9px 13px;
      border-radius: 13px;
      white-space: nowrap;
      font-weight: 800;
    }

    .progress-wrap {
      margin-top: 14px;
    }

    .progress-info {
      display: flex;
      justify-content: space-between;
      color: var(--muted);
      font-size: .9rem;
      margin-bottom: 6px;
    }

    .progress-track {
      height: 12px;
      background: #e2e8f0;
      border-radius: 20px;
      overflow: hidden;
    }

    .progress-bar {
      width: 0%;
      height: 100%;
      background: linear-gradient(90deg, #4f46e5, #06b6d4);
      border-radius: inherit;
      transition: width .35s ease;
    }

    /* GAME CARD */
    .game-card {
      background: rgba(255,255,255,.97);
      border-radius: 28px;
      padding: clamp(20px, 5vw, 42px);
      box-shadow: 0 15px 45px rgba(30,41,59,.10);
      min-height: 530px;
    }

    .level-label {
      display: inline-flex;
      padding: 7px 13px;
      background: #eef2ff;
      color: var(--primary);
      border-radius: 999px;
      font-weight: 800;
      font-size: .9rem;
      margin-bottom: 16px;
    }

    .question {
      font-size: clamp(1.35rem, 3.5vw, 2rem);
      line-height: 1.45;
      font-weight: 800;
      margin: 5px 0 28px;
      text-align: center;
    }

    .number-display {
      font-size: clamp(2rem, 8vw, 4rem);
      font-weight: 900;
      color: var(--primary);
      text-align: center;
      margin: 15px 0 25px;
      letter-spacing: 2px;
    }

    .options {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 14px;
      max-width: 800px;
      margin: 0 auto;
    }

    .option-btn {
      background: #f8fafc;
      color: var(--text);
      border: 2px solid var(--border);
      border-radius: 17px;
      padding: 17px 15px;
      min-height: 66px;
      cursor: pointer;
      font-size: 1.05rem;
      font-weight: 750;
      transition: .15s ease;
    }

    .option-btn:hover:not(:disabled) {
      border-color: var(--primary);
      background: #eef2ff;
      transform: translateY(-2px);
    }

    .option-btn:disabled {
      cursor: default;
    }

    .option-btn.correct {
      border-color: var(--success);
      background: #dcfce7;
      color: #166534;
      animation: correctPop .35s ease;
    }

    .option-btn.wrong {
      border-color: var(--danger);
      background: #fee2e2;
      color: #991b1b;
      animation: shake .35s ease;
    }

    @keyframes correctPop {
      50% { transform: scale(1.03); }
    }

    @keyframes shake {
      25% { transform: translateX(-5px); }
      50% { transform: translateX(5px); }
      75% { transform: translateX(-3px); }
    }

    .feedback {
      margin: 24px auto 0;
      max-width: 800px;
      border-radius: 18px;
      padding: 17px;
      line-height: 1.55;
      display: none;
    }

    .feedback.show {
      display: block;
      animation: fadeUp .25s ease;
    }

    .feedback.correct {
      background: #ecfdf5;
      border: 2px solid #86efac;
      color: #166534;
    }

    .feedback.wrong {
      background: #fff7ed;
      border: 2px solid #fdba74;
      color: #9a3412;
    }

    @keyframes fadeUp {
      from { opacity: 0; transform: translateY(8px); }
      to { opacity: 1; transform: translateY(0); }
    }

    .feedback-title {
      font-weight: 900;
      font-size: 1.05rem;
      margin-bottom: 4px;
    }

    .next-wrap {
      text-align: center;
      margin-top: 20px;
    }

    .next-btn {
      display: none;
    }

    .next-btn.show {
      display: inline-block;
    }

    /* RESULT */
    .result-card {
      background: rgba(255,255,255,.97);
      border-radius: 30px;
      padding: clamp(25px, 6vw, 50px);
      box-shadow: 0 15px 50px rgba(30,41,59,.11);
      text-align: center;
    }

    .result-icon {
      font-size: 72px;
      margin-bottom: 8px;
    }

    .result-card h2 {
      font-size: clamp(2rem, 6vw, 3.2rem);
      color: var(--primary);
      margin: 0 0 10px;
    }

    .final-score {
      font-size: clamp(2.5rem, 8vw, 5rem);
      font-weight: 900;
      color: var(--secondary);
      margin: 10px 0 25px;
    }

    .result-stats {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 15px;
      max-width: 650px;
      margin: 0 auto 30px;
    }

    .result-stat {
      padding: 18px;
      border-radius: 18px;
      background: #f8fafc;
      border: 1px solid var(--border);
    }

    .result-stat .value {
      font-size: 1.8rem;
      font-weight: 900;
      display: block;
      margin-bottom: 5px;
    }

    .result-stat .label {
      color: var(--muted);
      font-size: .9rem;
    }

    .reflection {
      max-width: 700px;
      margin: 0 auto 25px;
      text-align: left;
      background: #f8fafc;
      padding: 20px;
      border-radius: 18px;
      border-left: 5px solid var(--primary);
    }

    .reflection p {
      margin: 9px 0;
      line-height: 1.5;
    }

    .reflection strong {
      color: var(--primary-dark);
    }

    .stars {
      font-size: 2.1rem;
      letter-spacing: 4px;
      margin-bottom: 20px;
    }

    .hidden {
      display: none !important;
    }

    /* RESPONSIVE */
    @media (max-width: 700px) {
      .app {
        width: 94%;
        padding-top: 12px;
      }

      .start-card {
        min-height: auto;
        padding: 20px 0;
      }

      .city {
        padding: 25px 17px;
        border-radius: 24px;
      }

      .logo {
        font-size: 56px;
      }

      .instructions {
        grid-template-columns: 1fr;
      }

      .top-row {
        grid-template-columns: 1fr 1fr 1fr;
      }

      .game-title {
        grid-column: 1 / -1;
      }

      .stat {
        justify-content: center;
        font-size: .85rem;
      }

      .game-card {
        padding: 22px 15px;
      }

      .options {
        grid-template-columns: 1fr;
      }

      .result-stats {
        grid-template-columns: 1fr;
      }
    }

    @media (max-width: 420px) {
      .top-row {
        grid-template-columns: 1fr 1fr;
      }

      .game-title {
        grid-column: 1 / -1;
      }

      .stat:last-child {
        grid-column: 1 / -1;
      }
    }
  </style>
</head>

<body>
  <main class="app">

    <!-- =========================
         LAYAR PEMBUKA
    ========================== -->
    <section id="startScreen" class="screen active">
      <div class="start-card">
        <div class="city">
          <div class="logo">🏙️🔢⭐</div>

          <h1>Petualangan Bilangan</h1>
          <h2>Misi 100.000</h2>

          <p class="subtitle">
            Selamat datang di <strong>Kota Matematika!</strong>
            Jadilah penjelajah hebat dan selesaikan berbagai tantangan
            bilangan untuk membuka area kota dan mengumpulkan bintang.
          </p>

          <div class="instructions">
            <div class="instruction">
              <span class="icon">🧠</span>
