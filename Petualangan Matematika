          </button>
        </div>
      </div>
    </section>

    <!-- =========================
         LAYAR PERMAINAN
    ========================== -->
    <section id="gameScreen" class="screen">

      <header class="game-header">
        <div class="top-row">
          <div class="game-title">🏙️ Misi 100.000</div>

          <div class="stat">
            ⭐ <span id="scoreDisplay">0</span>
          </div>

          <div class="stat">
            ❤️ <span id="livesDisplay">3</span>
